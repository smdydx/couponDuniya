
# Production Environment Variables

# App Configuration
APP_NAME="CouponDuniya"
APP_ENV=production
DEBUG=false

# Database (PostgreSQL on Replit)
DATABASE_URL=postgresql://user:password@hostname:5432/couponduniya_prod

# Redis (Production)
REDIS_URL=redis://hostname:6379/0

# Security
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_64_CHARS_MIN
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Origins (Add your Replit deployment URL)
ALLOWED_ORIGINS=https://your-app.replit.app,https://your-custom-domain.com

# SMS (MSG91)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=COUPON

# Email (SendGrid/SMTP)
SENDGRID_API_KEY=your_sendgrid_api_key
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_sendgrid_api_key
FROM_EMAIL=noreply@couponduniya.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_dsn
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100

# Admin IP Whitelist (comma-separated)
ADMIN_IP_WHITELIST=127.0.0.1

# Workers
AFFILIATE_SYNC_ENABLED=true
AFFILIATE_SYNC_INTERVAL_MINUTES=1440
